{
  "name": "vsce-claude-clarity",
  "version": "0.2.3",
  "description": "Show model, context, and rate-limit bars in the Claude Code VS Code extension's input row",
  "type": "module",
  "bin": {
    "vsce-claude-clarity": "./apply.mjs"
  },
  "scripts": {
    "apply": "node apply.mjs",
    "remove": "node apply.mjs --remove",
    "ext:build": "npm --prefix ext run build",
    "ext:install": "npm --prefix ext run install-local"
  },
  "author": "Dustin Lacewell",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ldlework/vsce-claude-clarity"
  }
}
